# TBC Fleet and Transport Management System (TBC-FTMS)
# Configuration - copy to .env and adjust for your environment.
# Never commit real secrets to version control.

# Application
APP_NAME=TBC Fleet and Transport Management System
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (SQLite default for development; PostgreSQL for production)
# Example PostgreSQL: DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/tbc_ftms
DATABASE_URL=sqlite:///./tbc_ftms.db

# Security
BCRYPT_ROUNDS=12
SESSION_IDLE_TIMEOUT_MINUTES=480
SESSION_ABSOLUTE_TIMEOUT_HOURS=24
ALLOWED_HOSTS=*

# Institutional branding / defaults
DEFAULT_LANGUAGE=sw  # sw = Kiswahili, en = English
INSTITUTION_NAME=Tanzania Broadcasting Corporation (TBC)
INSTITUTION_SHORT=TBC
INSTITUTION_MOTTO=Ukweli na Uhakika
TIMEZONE=Africa/Dar_es_Salaam
CURRENCY=TZS

# Optional integrations (leave blank to use in-app only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMS_GATEWAY_URL=
SMS_API_KEY=

# File storage
MAX_UPLOAD_MB=10
UPLOAD_DIR=app/static/uploads

# Demo data flag (set false before production)
SEED_DEMO_DATA=true
